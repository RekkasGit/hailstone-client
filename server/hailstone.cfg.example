; hailstone.cfg: the rules Hailstone clients follow on this server (docs/plugins.md). Copy it to client_files/
; as hailstone.cfg. Players get it at their next login. Without this file the client sets no rules at all.
;
; The server's own scripts (client_files/scripts/) and plugins (client_files/plugins/<platform>/) always run, with
; every capability. These settings are about the player's own.
;
; Capabilities: read, commands, target, actions, move, chat, events, ui, packets, or all.

[scripts]
player = off              ; the player's own Lua scripts: on / off
;player_caps = read,ui    ; what they may do when on (default all)
;run = hud                ; the server's scripts started at each zone-in

[plugins]
player = off              ; the player's own compiled plugins: on / off
;player_caps = read       ; what they may do when on (default all)

[assets]
player = on               ; off: of servers/<profile>/assets/, only the server's files and textures count

[socials]
mode = press              ; Lua socials: off / press / full
caps = read,target,actions
press_commands = 5        ; press mode: the most commands one press sends (0: no limit)
faces = on                ; button faces may read the game state

[movement]
npc_collision = on        ; live NPCs block players (players, pets, mercenaries and corpses never do). On by default,
                          ; also without this file; off: everyone walks through everyone, as in the original client
passable_ladders = on     ; walking or swimming into a ladder whose polygons are all passable (the Cabilis canal
                          ; ladders) climbs it. On by default, also without this file; off: as in the original
                          ; client, such a ladder is only mounted by a click from the top

[addons]
;suggest = owner/repo     ; add-ons of this server's own on GitHub: the login screen suggests each to players who do not
                          ; have it (docs/addons.md "Suggested add-ons")
